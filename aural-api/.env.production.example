NODE_ENV=production
# starter: only the approved homepage and knowledge articles are public.
# Keep NUXT_PUBLIC_SITE_MODE identical when building/running the website.
PUBLIC_SITE_MODE=full
DATABASE_URL="file:/srv/hushi/shared/prod.db"
PUBLIC_SITE_URL=https://www.your-company-domain.com
PUBLIC_ADMIN_URL=https://admin.your-company-domain.com
API_PUBLIC_URL=https://api.your-company-domain.com
UPLOAD_PUBLIC_BASE=https://api.your-company-domain.com
ALLOWED_ORIGINS=https://www.your-company-domain.com,https://your-company-domain.com,https://admin.your-company-domain.com

# Replace every value before launch. Production will refuse unsafe defaults.
ADMIN_USERNAME=ops_admin
ADMIN_PASSWORD=Replace-With-A-Strong-Password-2026!
ADMIN_TOKEN_SECRET=replace-with-a-64-character-random-token-secret-before-launch
# 自登录起的最长会话时长（12 小时），续期不会延长
ADMIN_TOKEN_TTL_MS=43200000
# 无操作多久后需重新登录（30 分钟）
ADMIN_IDLE_TIMEOUT_MS=1800000
# 联系方式查看：所有账号、两类客户资料合并计数；达到阈值仅告警，不阻断。
# 同一账号在一个时间窗内只生成一条告警；重复查看也计数。
CONTACT_VIEW_WINDOW_MS=600000
CONTACT_VIEW_ALERT_THRESHOLD=30
ADMIN_IP_ALLOWLIST=
SENSITIVE_CONFIRMATION_TEXT=确认执行

PUBLIC_FORM_RATE_WINDOW_MS=600000
PUBLIC_FORM_RATE_LIMIT=5
PUBLIC_FORM_MIN_ELAPSED_MS=1800
PUBLIC_FORM_MAX_AGE_MS=3600000

API_RATE_WINDOW_MS=60000
API_RATE_LIMIT=180
RATE_LIMIT_STORE=memory
MAX_UPLOAD_BYTES=20971520
MAX_IMAGE_PIXELS=24000000
CLAMAV_SCAN_COMMAND=

# generic, wecom, dingtalk, or feishu; match the receiving bot platform.
ALERT_WEBHOOK_PROVIDER=generic
ALERT_WEBHOOK_URL=
ALERT_EMAIL_TO=
ANALYTICS_RETENTION_DAYS=180
API_LOG_RETENTION_DAYS=90
ALERT_RETENTION_DAYS=180

API_PM2_NAME=company-api
WEB_PM2_NAME=company-web

# Release layout: all persistent data lives outside releases. Replace paths for your server.
UPLOAD_DIR=/srv/hushi/shared/uploads
DATABASE_BACKUP_DIR=/srv/hushi/shared/backups
BACKUP_RETENTION_DAYS=14
DEPLOY_RELEASES_DIR=/srv/hushi/releases
DEPLOY_CURRENT_LINK=/srv/hushi/current
DEPLOY_WRITE_GATE_FILE=/srv/hushi/shared/deploy-write-gate
TRUST_PROXY=loopback
# Email-only delivery is unsupported; leave ALERT_EMAIL_TO empty and use the Webhook above.

# Unattended deployment checks the private-session authentication boundary.
# Run a separate manual login/MFA acceptance with this flag; supply the current
# POST_DEPLOY_TOTP_CODE in the process environment, never persist an OTP here.
POST_DEPLOY_CHECK_LOGIN=0
# Running API creates a verified database + uploads bundle daily and checks hourly.
# Retention always preserves the newest two verified complete recovery points.

# Also set SHUTDOWN_TIMEOUT_MS explicitly in PM2 env; .env alone cannot prove its running value.
# Graceful SIGINT/SIGTERM budget; PM2 kill_timeout must exceed this by at least 5000ms.
SHUTDOWN_TIMEOUT_MS=60000

# Periodic full audit verification (ms): failures alert, never reseal history.
AUDIT_VERIFY_INTERVAL_MS=86400000

# 发布/回滚就绪检查：等待 API 和页面初始化，不等于业务 RTO 或停机预算。
# 每次 HTTP 请求（含响应体）上限 1–60000ms；整体就绪等待 1–300000ms；重试间隔 1–10000ms。
POST_DEPLOY_TIMEOUT_MS=10000
POST_DEPLOY_READY_TIMEOUT_MS=60000
POST_DEPLOY_READY_INTERVAL_MS=1000
# 生产公开 URL 必须是有效 HTTPS，不能含凭证或回环地址。
# ALLOWED_ORIGINS 仅含 origin（可有末尾 /），不能带路径、查询或片段。
